# ─── App ──────────────────────────────────────────────
# URL pública de la app (en Netlify: https://tu-sitio.netlify.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (Project Settings → API) ────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (solo servidor). Se usa para crear pacientes desde el panel admin.
SUPABASE_SECRET_KEY=
# Conexión directa a Postgres (Project Settings → Database → Connection string, modo "Transaction pooler")
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Mostrar botón "Continuar con Google" (requiere configurar el proveedor en Supabase)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ─── Email (Gmail SMTP gratis: smtp.gmail.com / 465 / contraseña de aplicación) ─
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Clínica Dental <no-reply@localhost>"
# Email que recibe los avisos de nuevas solicitudes
ADMIN_NOTIFY_EMAIL=admin@localhost

# ─── Cron ─────────────────────────────────────────────
# Secreto compartido entre la función programada de Netlify y /api/cron/reminders
CRON_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
